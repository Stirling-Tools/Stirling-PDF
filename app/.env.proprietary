# Committed defaults for `task backend:dev:proprietary` (self-hosted / proprietary
# flavor). Local overrides + secrets live in app/.env.proprietary.local (ignored).

# Combined-billing account link (Mode A). On by default: the free tier is metered locally and
# needs no Stirling account, so this gates linking rather than the feature.
STIRLING_BILLING_ACCOUNT_LINK_ENABLED=true
# SaaS base URL the linked instance calls (register + entitlement).
STIRLING_BILLING_ACCOUNT_LINK_SAAS_BASE_URL=https://api2.stirling.com
# Accrual against a linked team's cloud wallet. The local free-tier meter runs either way.
STIRLING_BILLING_ACCOUNT_LINK_METERING_ENABLED=true
