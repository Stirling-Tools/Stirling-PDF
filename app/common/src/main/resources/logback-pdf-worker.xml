<?xml version="1.0" encoding="UTF-8"?>
<!-- PDF worker processes: stdout carries the job protocol, so logs go to stderr only. -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [pdf-worker] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
