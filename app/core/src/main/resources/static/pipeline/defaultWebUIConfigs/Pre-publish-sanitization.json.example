{
  "name": "Strip hidden data before publishing",
  "pipeline": [
    {
      "operation": "/api/v1/security/sanitize-pdf",
      "parameters": {
        "removeJavaScript": true,
        "removeEmbeddedFiles": true,
        "removeXMPMetadata": true,
        "removeMetadata": true,
        "removeLinks": true,
        "removeFonts": false,
        "fileInput": "automated"
      }
    },
    {
      "operation": "/api/v1/misc/flatten",
      "parameters": {
        "flattenOnlyForms": true,
        "fileInput": "automated"
      }
    },
    {
      "operation": "removeAnnotations",
      "parameters": {
        "fileInput": "automated"
      }
    },
    {
      "operation": "/api/v1/misc/update-metadata",
      "parameters": {
        "deleteAll": true,
        "title": "",
        "author": "",
        "subject": "",
        "keywords": "",
        "creator": "",
        "producer": "",
        "creationDate": null,
        "modificationDate": null,
        "trapped": "Unknown",
        "customMetadata": [],
        "fileInput": "automated"
      }
    },
    {
      "operation": "/api/v1/misc/compress-pdf",
      "parameters": {
        "compressionLevel": 3,
        "grayscale": false,
        "expectedSize": "",
        "compressionMethod": "quality",
        "fileSizeValue": "",
        "fileSizeUnit": "MB",
        "fileInput": "automated"
      }
    }
  ],
  "_examples": {
    "outputDir": "{outputFolder}/{folderName}",
    "outputFileName": "{filename}-{pipelineName}-{date}-{time}"
  },
  "outputDir": "{outputFolder}",
  "outputFileName": "pre_publish_{filename}.PDF"
}
