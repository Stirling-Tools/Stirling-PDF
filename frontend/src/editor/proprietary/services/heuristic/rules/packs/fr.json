  "patterns": {
    "toc": [{ "pattern": "table des mati[èe]res" }],
    "references": [{ "pattern": "\\\\b(bibliographie|r[ée]f[ée]rences)\\\\b" }],
    "signature": [
      { "pattern": "\\\\b(signature|sign[ée]|lu et approuv[ée])\\\\b" }
    ],
    "signature_form": [
      { "pattern": "_{6,}\\\\s*\\\\n\\\\s*(date|nom|signature)", "flags": "i" }
    ],
    "email_from": [
      {
        "pattern": "\\\\bde\\\\s?:\\\\s.+\\\\n(.*\\\\n){0,3}?\\\\s*(à|envoy[ée]|date)\\\\s?:\\\\s",
        "flags": "i"
      }
    ],
    "email_subject": [{ "pattern": "objet\\\\s?:\\\\s" }],
    "currency": [{ "pattern": "\\\\d[\\\\d .,]*\\\\s?(eur|€)|€\\\\s?\\\\d" }],
    "form_label": [
      {
        "pattern": "^[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ /()&'.-]{2,30}\\\\s?:\\\\s*$",
        "flags": "m"
      }
    ]
  }
}
