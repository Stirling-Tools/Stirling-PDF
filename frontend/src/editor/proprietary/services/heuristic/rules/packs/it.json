  "patterns": {
    "toc": [{ "pattern": "indice" }],
    "references": [{ "pattern": "\\\\b(bibliografia|riferimenti)\\\\b" }],
    "signature": [{ "pattern": "\\\\b(firma|firmato|sottoscritto)\\\\b" }],
    "signature_form": [
      { "pattern": "_{6,}\\\\s*\\\\n\\\\s*(data|nome|firma)", "flags": "i" }
    ],
    "email_from": [
      {
        "pattern": "\\\\bda\\\\s?:\\\\s.+\\\\n(.*\\\\n){0,3}?\\\\s*(a|inviato|data)\\\\s?:\\\\s",
        "flags": "i"
      }
    ],
    "email_subject": [{ "pattern": "oggetto\\\\s?:\\\\s" }],
    "currency": [{ "pattern": "\\\\d[\\\\d .,]*\\\\s?(eur|€)|€\\\\s?\\\\d" }],
    "form_label": [
      {
        "pattern": "^[A-Za-zÀÈÉÌÒÙàèéìòù][A-Za-zÀÈÉÌÒÙàèéìòù /()&'.-]{2,30}\\\\s?:\\\\s*$",
        "flags": "m"
      }
    ]
  }
