  "patterns": {
    "toc": [{ "pattern": "[íi]ndice" }],
    "references": [{ "pattern": "\\\\b(bibliograf[íi]a|referencias)\\\\b" }],
    "signature": [{ "pattern": "\\\\b(firma|firmado|fdo)\\\\b" }],
    "signature_form": [
      { "pattern": "_{6,}\\\\s*\\\\n\\\\s*(fecha|nombre|firma)", "flags": "i" }
    ],
    "email_from": [
      {
        "pattern": "\\\\bde\\\\s?:\\\\s.+\\\\n(.*\\\\n){0,3}?\\\\s*(para|enviado|fecha)\\\\s?:\\\\s",
        "flags": "i"
      }
    ],
    "email_subject": [{ "pattern": "asunto\\\\s?:\\\\s" }],
    "currency": [{ "pattern": "\\\\d[\\\\d .,]*\\\\s?(eur|€)|€\\\\s?\\\\d" }],
    "form_label": [
      {
        "pattern": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ][A-Za-zÁÉÍÓÚÜÑáéíóúüñ /()&'.-]{2,30}\\\\s?:\\\\s*$",
        "flags": "m"
      }
    ]
  }
}
