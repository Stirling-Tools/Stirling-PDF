  "patterns": {
    "toc": [{ "pattern": "spis tre[śs]ci" }],
    "references": [{ "pattern": "\\\\b(bibliografia|literatura)\\\\b" }],
    "signature": [{ "pattern": "\\\\b(podpis|podpisano)\\\\b" }],
    "signature_form": [
      { "pattern": "_{6,}\\\\s*\\\\n\\\\s*(data|imi[ęe]|podpis)", "flags": "i" }
    ],
    "email_from": [
      {
        "pattern": "\\\\bod\\\\s?:\\\\s.+\\\\n(.*\\\\n){0,3}?\\\\s*(do|wys[łl]ano|data)\\\\s?:\\\\s",
        "flags": "i"
      }
    ],
    "email_subject": [{ "pattern": "temat\\\\s?:\\\\s" }],
    "currency": [{ "pattern": "\\\\d[\\\\d .,]*\\\\s?(pln|z[łl])" }],
    "form_label": [
      {
        "pattern": "^[A-Za-ząćęłńóśźż][A-Za-ząćęłńóśźż /()&'.-]{2,30}\\\\s?:\\\\s*$",
        "flags": "m"
      }
    ]
  }
}
