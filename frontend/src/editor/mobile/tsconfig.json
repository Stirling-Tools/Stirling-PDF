{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@editor/*": [
        "../../editor/mobile/*",
        "../../editor/tauri/*",
        "../../editor/cloud/*",
        "../../editor/proprietary/*",
        "../../editor/core/*"
      ],
      "@editor/portal/*": [
        "../../editor/mobile/portal/*",
        "../../editor/tauri/portal/*",
        "../../editor/cloud/portal/*",
        "../../editor/proprietary/portal/*",
        "../../editor/core/portal/*",
        "../../processor/proprietary/*"
      ],
      "@processor/*": ["../../processor/proprietary/*"],
      "@editor-tauri/*": ["../../editor/tauri/*"],
      "@editor-cloud/*": ["../../editor/cloud/*"],
      "@editor-proprietary/*": ["../../editor/proprietary/*"],
      "@editor-core/*": ["../../editor/core/*"]
    }
  },
  "include": [
    "../../global.d.ts",
    "../../*.js",
    "../../*.ts",
    "../../*.tsx",
    "../core/setupTests.ts",
    ".",
    "../tauri"
  ]
