{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/*": [
        "../../editor/saas/*",
        "../../editor/cloud/*",
        "../../editor/proprietary/*",
        "../../editor/core/*"
      ],
      "@app/portal/*": [
        "../../editor/saas/portal/*",
        "../../editor/cloud/portal/*",
        "../../editor/proprietary/portal/*",
        "../../editor/core/portal/*",
        "../../processor/saas/*",
        "../../processor/proprietary/*"
      ],
      "@portal/*": ["../../processor/saas/*", "../../processor/proprietary/*"],
      "@portal-proprietary/*": ["../../processor/proprietary/*"],
      "@cloud/*": ["../../editor/cloud/*"],
      "@proprietary/*": ["../../editor/proprietary/*"],
      "@core/*": ["../../editor/core/*"]
    }
  },
  "include": [
    "../../global.d.ts",
    "../../*.js",
    "../../*.ts",
    "../../*.tsx",
    ".",
    "../../processor/saas"
  ]
}
