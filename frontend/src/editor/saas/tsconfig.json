{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@editor/*": [
        "../../editor/saas/*",
        "../../editor/cloud/*",
        "../../editor/proprietary/*",
        "../../editor/core/*"
      ],
      "@editor/portal/*": [
        "../../editor/saas/portal/*",
        "../../editor/cloud/portal/*",
        "../../editor/proprietary/portal/*",
        "../../editor/core/portal/*",
        "../../processor/saas/*",
        "../../processor/proprietary/*"
      ],
      "@processor/*": [
        "../../processor/saas/*",
        "../../processor/proprietary/*"
      ],
      "@processor-proprietary/*": ["../../processor/proprietary/*"],
      "@editor-cloud/*": ["../../editor/cloud/*"],
      "@editor-proprietary/*": ["../../editor/proprietary/*"],
      "@editor-core/*": ["../../editor/core/*"]
    }
  },
  "include": [
    "../../global.d.ts",
    "../../*.js",
    "../../*.ts",
    "../../*.tsx",
    ".",
    "../../processor/saas"
  ]
}
