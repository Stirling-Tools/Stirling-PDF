# Generated by Cargo
# will have compiled files and executables — match nested target/ dirs too
# (provisioner/target/, thumbnail-handler/target/) since each sub-crate has
# its own Cargo workspace under src-tauri/.
target/
/gen/schemas
/runtime/
/vendor/jemalloc/*
!/vendor/jemalloc/.gitkeep
!/vendor/jemalloc/LICENSE

**/stirling_thumbnail_handler.dll
