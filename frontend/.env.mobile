###############################################################################
# Frontend environment variables for mobile (Tauri iOS/Android) builds.
# Layered on top of .env when running in mobile mode.
# Values can be overridden in the uncommitted sibling `.env.mobile.local` file.
# Note: This file is committed to Git, so should not contain any private keys.
###############################################################################

# Mobile has no bundled backend; leave blank. Tools run against the connected
# server (SaaS or self-hosted), chosen at runtime in the connection settings.
VITE_DESKTOP_BACKEND_URL=

# SaaS auth integration
VITE_SAAS_SERVER_URL=https://auth.stirling.com
VITE_SAAS_BACKEND_API_URL=https://api2.stirling.com

# Dev only: set to true to mimic an expired access token.
VITE_DEV_SIMULATE_EXPIRED_JWT=
