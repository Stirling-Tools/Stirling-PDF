{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/*": [
        "../../src/desktop/*",
        "../../src/cloud/*",
        "../../src/proprietary/*",
        "../../src/core/*"
      ],
      "@app/portal/*": [
        "../../src/desktop/portal/*",
        "../../src/cloud/portal/*",
        "../../src/proprietary/portal/*",
        "../../src/core/portal/*",
        "../../src/portal-desktop/*",
        "../../src/portal/*"
      ],
      "@portal/*": ["../../src/portal-desktop/*", "../../src/portal/*"],
      "@portal-proprietary/*": ["../../src/portal/*"],
      "@portal-cloud/*": ["../../src/portal-cloud/*"],
      "@cloud/*": ["../../src/cloud/*"],
      "@proprietary/*": ["../../src/proprietary/*"],
      "@core/*": ["../../src/core/*"]
    }
  },
  "include": [
    "../global.d.ts",
    "../*.js",
    "../*.ts",
    "../*.tsx",
    "../core/setupTests.ts",
    ".",
    "../portal-desktop"
  ]
}
