  "patterns": {
    "toc": [{ "pattern": "inhoudsopgave" }],
    "references": [{ "pattern": "\\\\b(bibliografie|literatuurlijst)\\\\b" }],
    "signature": [
      { "pattern": "\\\\b(handtekening|ondertekend|getekend)\\\\b" }
    ],
    "signature_form": [
      {
        "pattern": "_{6,}\\\\s*\\\\n\\\\s*(datum|naam|handtekening)",
        "flags": "i"
      }
    ],
    "email_from": [
      {
        "pattern": "\\\\bvan\\\\s?:\\\\s.+\\\\n(.*\\\\n){0,3}?\\\\s*(aan|verzonden|datum)\\\\s?:\\\\s",
        "flags": "i"
      }
    ],
    "email_subject": [{ "pattern": "betreft\\\\s?:\\\\s" }],
    "currency": [{ "pattern": "\\\\d[\\\\d .,]*\\\\s?(eur|€)|€\\\\s?\\\\d" }],
    "form_label": [
      {
        "pattern": "^[A-Za-zëéïöü][A-Za-zëéïöü /()&'.-]{2,30}\\\\s?:\\\\s*$",
        "flags": "m"
      }
    ]
  }
}
