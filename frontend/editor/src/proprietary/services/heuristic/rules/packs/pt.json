  "patterns": {
    "toc": [{ "pattern": "[íi]ndice" }],
    "signature": [{ "pattern": "\\\\b(assinatura|assinado)\\\\b" }],
    "signature_form": [
      {
        "pattern": "_{6,}\\\\s*\\\\n\\\\s*(data|nome|assinatura)",
        "flags": "i"
      }
    ],
    "references": [{ "pattern": "\\\\b(bibliografia|refer[êe]ncias)\\\\b" }],
    "email_from": [
      {
        "pattern": "\\\\bde\\\\s?:\\\\s.+\\\\n(.*\\\\n){0,3}?\\\\s*(para|enviado|data)\\\\s?:\\\\s",
        "flags": "i"
      }
    ],
    "email_subject": [{ "pattern": "assunto\\\\s?:\\\\s" }],
    "currency": [
      {
        "pattern": "\\\\d[\\\\d .,]*\\\\s?(eur|brl|€|r\\\\$)|(€|r\\\\$)\\\\s?\\\\d"
      }
    ],
    "form_label": [
      {
        "pattern": "^[A-Za-zÁÂÃÀÇÉÊÍÓÔÕÚáâãàçéêíóôõú][A-Za-zÁÂÃÀÇÉÊÍÓÔÕÚáâãàçéêíóôõú /()&'.-]{2,30}\\\\s?:\\\\s*$",
        "flags": "m"
      }
    ]
  }
}
