{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/*": [
        "../../src/cloud/*",
        "../../src/proprietary/*",
        "../../src/core/*"
      ],
      "@app/portal/*": [
        "../../src/cloud/portal/*",
        "../../src/proprietary/portal/*",
        "../../src/core/portal/*",
        "../../src/portal/*"
      ],
      "@portal/*": ["../../src/portal/*"],
      "@cloud/*": ["../../src/cloud/*"],
      "@proprietary/*": ["../../src/proprietary/*"],
      "@core/*": ["../../src/core/*"]
    }
  },
  "include": ["../global.d.ts", "."]
}
