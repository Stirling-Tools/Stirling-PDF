{
  "extends": "./tsconfig.proprietary.vite.json",
  "compilerOptions": {
    "paths": {
      "@app/*": [
        "./src/desktop/*",
        "./src/cloud/*",
        "./src/proprietary/*",
        "./src/core/*"
      ],
      "@app/portal/*": [
        "./src/desktop/portal/*",
        "./src/cloud/portal/*",
        "./src/proprietary/portal/*",
        "./src/core/portal/*",
        "./src/portal/*"
      ],
      "@portal/*": ["./src/portal/*"],
      "@cloud/*": ["./src/cloud/*"],
      "@proprietary/*": ["./src/proprietary/*"],
      "@core/*": ["./src/core/*"]
    }
  },
  "exclude": [
    "src/core/**/*.test.ts*",
    "src/core/**/*.spec.ts*",
    "src/proprietary/**/*.test.ts*",
    "src/proprietary/**/*.spec.ts*",
    "src/cloud/**/*.test.ts*",
    "src/cloud/**/*.spec.ts*",
    "src/saas",
    "src/prototypes",
    "src/portal-saas",
    "src/portal/**/*.test.ts*",
    "src/portal/**/*.spec.ts*"
  ]
}
