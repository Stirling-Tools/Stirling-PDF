{
  "extends": "./tsconfig.proprietary.vite.json",
  "compilerOptions": {
    "paths": {
      "@app/*": ["./src/prototypes/*", "./src/proprietary/*", "./src/core/*"],
      "@proprietary/*": ["./src/proprietary/*"],
      "@core/*": ["./src/core/*"],
      "@app/portal/*": [
        "./src/prototypes/portal/*",
        "./src/proprietary/portal/*",
        "./src/core/portal/*",
        "./src/portal/*"
      ],
      "@portal/*": ["./src/portal/*"]
    }
  },
  "exclude": [
    "src/core/**/*.test.ts*",
    "src/core/**/*.spec.ts*",
    "src/proprietary/**/*.test.ts*",
    "src/proprietary/**/*.spec.ts*",
    "src/desktop",
    "src/saas"
  ]
}
