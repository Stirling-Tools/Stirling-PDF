{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@app/*": [
        "./src/saas/*",
        "./src/cloud/*",
        "./src/proprietary/*",
        "./src/core/*"
      ],
      "@app/portal/*": [
        "./src/saas/portal/*",
        "./src/cloud/portal/*",
        "./src/proprietary/portal/*",
        "./src/core/portal/*",
        "./src/portal-saas/*",
        "./src/portal/*"
      ],
      "@portal/*": ["./src/portal-saas/*", "./src/portal/*"],
      "@portal-proprietary/*": ["./src/portal/*"],
      "@cloud/*": ["./src/cloud/*"],
      "@proprietary/*": ["./src/proprietary/*"],
      "@core/*": ["./src/core/*"]
    }
  },
  "exclude": [
    "src/core/**/*.test.ts*",
    "src/core/**/*.spec.ts*",
    "src/proprietary/**/*.test.ts*",
    "src/proprietary/**/*.spec.ts*",
    "src/cloud/**/*.test.ts*",
    "src/cloud/**/*.spec.ts*",
    "src/desktop"
  ]
}
