root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
max_line_length = 127
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 120

[*.gradle]
indent_size = 4

[*.html]
indent_size = 2

[{*.js,*.jsx,*.mjs,*.ts,*.tsx,*.mts}]
indent_size = 2

[*.css]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2
