###############################################################################
# Committed defaults for `task`, loaded by every task via the root Taskfile's
# `dotenv:` list. Sits in .task/ because it is the only file here that is
# tracked; everything else in that directory is a Task cache. Override in the
# uncommitted sibling .task/.env.local.
###############################################################################

# Cap the worker count for the check/test/lint tasks so they don't swamp a busy
# machine. Leave empty for tool defaults.
STIRLING_CHECK_JOBS=
